# -- LINE Messaging API - Stock_AI_agent Bot ---
CHANNEL_STOCK_USER_ID=your_line_user_id_here
CHANNEL_STOCK_ID=your_channel_id_here
CHANNEL_STOCK_BASIC_ID=@your_basic_id
CHANNEL_STOCK_SECRET=your_channel_secret_here
CHANNEL_STOCK_ACCESS_TOKEN=your_channel_access_token_here
CHANNEL_STOCK_URL=https://your-app.onrender.com/webhook

# Anthropic Claude — AI 盤勢解讀（選填；未設定則略過，僅顯示規則型分析）
ANTHROPIC_API_KEY=your_anthropic_api_key
# 與 ANTHROPIC_API_KEY 擇一（向下相容 backup\.env 鍵名）
# CHANNEL_STOCK_Claude_Token=
# 選填，預設 claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL=

# 多人推播（選填，逗號分隔；與 CHANNEL_STOCK_USER_ID 擇一或併用，依 line_push 讀取順序）
# CHANNEL_STOCK_USER_IDS=Uxxx,Uyyy

# 從 Google Drive 拉取「這份」.env 時，請勿把下列變數放在雲端檔案內；改在終端機 / 系統環境設定
# GOOGLE_DRIVE_DOTENV_FILE_ID=
# GOOGLE_DRIVE_DOTENV_URL=https://drive.google.com/file/d/xxxx/view
# GOOGLE_DRIVE_DOTENV_OUTPUT=.env

# Flask 設定
PORT=5000
FLASK_ENV=production
